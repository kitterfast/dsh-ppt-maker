{
  "html": "../deck/deck.html",
  "out": "../deck/render",
  "pptx": "../deck/AI通史-修复版.pptx",
  "width": 1280,
  "height": 720,
  "slide": ".slide",
  "page": ".page",
  "chrome": [
    "#progress",
    ".nav",
    ".hintbar"
  ],
  "goto": "window.__slideInfo.go",
  "groups": {
    "selector": ".body > *",
    "delays": [
      60,
      170,
      280,
      390,
      500
