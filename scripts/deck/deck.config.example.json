    "stagger": 110,
    "duration": 500,
    "moveY": 14,
    "easing": [
      0.22,
      0.61,
      0.36,
      1
    ]
  },
  "transitionMs": 450,
  "settleMs": 400,
  "capturePad": 2,
  "baseQuality": 88,
  "referencePx": {
    "width": 1280,
    "height": 720
  },
  "gif": {
    "maxPeriodMs": 15000,
    "intervalMs": 70,
    "leadMs": 1500
  }
}
